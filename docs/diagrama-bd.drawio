        </mxCell>
        <!-- USERS -->
        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;&lt;div style=&apos;text-align:left&apos;&gt;PK &amp;nbsp; id &amp;nbsp; varchar(20)&lt;br&gt;name &amp;nbsp; varchar(100)&lt;br&gt;UQ &amp;nbsp; email &amp;nbsp; varchar(254)&lt;br&gt;age &amp;nbsp; integer&lt;br&gt;phone &amp;nbsp; varchar(30)&lt;br&gt;isActive &amp;nbsp; boolean&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=top;spacingTop=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="260" height="150" as="geometry"/>
