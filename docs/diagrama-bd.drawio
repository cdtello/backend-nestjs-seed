        <!-- LEGEND -->
        <mxCell id="legend" value="Notas: PK=Primary Key • FK=Foreign Key • UQ=Unique • order_items es pivote con datos (quantity, unitPrice snapshot) — no ManyToMany directo • CASCADE: borrar orders borra items • Filtros Rama 4: Products ?name=&amp;minPrice=&amp;maxPrice=&amp;minStock=  Orders ?status=&amp;userId=" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
