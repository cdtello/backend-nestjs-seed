        <!-- RELATION EDGES -->
        <mxCell id="rel-users-orders" style="edgeStyle=entityRelationEdgeStyle;endArrow=ERmany;startArrow=ERone;fontSize=12;html=1;strokeColor=#6c8ebf;startFill=1;endFill=1;" edge="1" parent="1" source="users" target="orders">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="270"/><mxPoint x="180" y="310"/></Array></mxGeometry>
